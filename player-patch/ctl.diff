+
+/// Local control API for the Dj Ape1 Auto DJ engine. 127.0.0.1 only (Host check above) and
+/// enabled only when <data_dir>/control.token exists. Requires `Authorization: Bearer <token>`.
+///   GET  /api/status                       -> last state pushed by the UI
+///   POST /api/play|pause|stop|next|prev
+///   POST /api/playlist  {"name": "..."}    -> loads and starts the named playlist
+fn ctl(st: &AppState, mut rq: Request, path: &str, method: &Method) {
+    let want = match st.ctl_token() {
+        Some(t) => t,
+        None => return text(rq, 404, "not found"),
+    };
+    let expected = format!("Bearer {want}");
+    let ok = rq.headers().iter().any(|h| h.field.equiv("Authorization") && h.value.as_str() == expected);
+    if !ok {
+        return text(rq, 401, "unauthorized");
+    }
+    if path == "/api/status" && *method == Method::Get {
+        let v = st.status.lock().unwrap().clone();
+        return reply(rq, 200, "application/json", serde_json::to_vec(&v).unwrap_or_default());
+    }
+    if *method != Method::Post {
+        return text(rq, 404, "not found");
+    }
+    let mut body = Vec::new();
+    let _ = rq.as_reader().read_to_end(&mut body);
+    let arg: Value = serde_json::from_slice(&body).unwrap_or(Value::Null);
+    match path {
+        "/api/play" | "/api/pause" | "/api/stop" | "/api/next" | "/api/prev" => {
+            st.ctl_eval(json!({ "cmd": &path[5..] }));
+            reply(rq, 200, "application/json", b"{}".to_vec())
+        }
+        "/api/playlist" => match arg["name"].as_str() {
+            Some(n) if !n.is_empty() && n.len() < 200 => {
+                st.ctl_eval(json!({ "cmd": "playlist", "name": n }));
+                reply(rq, 200, "application/json", b"{}".to_vec())
+            }
+            _ => text(rq, 400, "missing name"),
+        },
+        _ => text(rq, 404, "not found"),
+    }
+}
